{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breakpeek.dev/schemas/manifest.schema.json",
  "title": "Breakpeek published manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "generatedAt", "keyId", "sources", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^[0-9]{14}-[a-f0-9]{16}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "keyId": { "type": ["string", "null"] },
    "signature": { "type": ["string", "null"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "defaultEnabled", "order", "path", "sha256", "bytes", "itemCount"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "defaultEnabled": { "type": "boolean" },
          "order": { "type": "integer", "minimum": 0 },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "itemCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
