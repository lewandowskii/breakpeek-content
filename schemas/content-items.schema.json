{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breakpeek.dev/schemas/content-items.schema.json",
  "title": "Breakpeek content source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "summary", "bodyFormat", "tags"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
          "kind": { "enum": ["interview", "news", "tip", "joke"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
          "body": { "type": "string", "minLength": 1 },
          "bodyFormat": { "enum": ["plain", "markdown"] },
          "publishedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    }
  }
}
